# -----------------------------------------------------------------------------
# KAN-REC - plantilla de configuracion
#
#   cp .env.example .env      y rellena los valores reales
#
# .env esta en .gitignore y NUNCA debe subirse al repositorio.
# En Microsoft Fabric estos valores se leen de Azure Key Vault (KANREC_KEY_VAULT),
# con el nombre del secreto en minusculas y guiones: ATLAS_URI -> atlas-uri
# -----------------------------------------------------------------------------

# MongoDB Atlas - cluster ClusterKanrec (M0)
ATLAS_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=ClusterKanrec

# MongoDB local para desarrollo y tests (no es un secreto)
MONGODB_URI=mongodb://localhost:27017

# Confluent Cloud - cluster lkc-5756j1z (GCP us-east1)
CONFLUENT_BOOTSTRAP=pkc-619z3.us-east1.gcp.confluent.cloud:9092
CONFLUENT_API_KEY=<api-key>
CONFLUENT_API_SECRET=<api-secret>
CONFLUENT_TOPIC=ad_impressions

# Mock Item Metadata API (tunel ngrok, cambia en cada sesion)
ITEM_API_BASE=https://<subdominio>.ngrok-free.dev

# Azure Key Vault usado desde los notebooks de Fabric
KANREC_KEY_VAULT=kanrec-kv
